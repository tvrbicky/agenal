# Zkopírujte na .env a vyplňte (soubor .env nikam neposílejte ani necommitujte)

# Účet DIP / PND ČEZ Distribuce
CEZ_USER=vas@email.cz
CEZ_PASSWORD=
CEZ_ELM=            # číslo elektroměru nebo název množiny zařízení v PND (např. 44570276)

# Přihlášení do webového rozhraní
WEB_USER=admin
WEB_PASSWORD=

# Plán stahování (cron: minuta hodina den měsíc den_v_týdnu), stahuje se včerejšek
PLAN_CRON=30 6 * * *

# Sestava v PND: „1/4 diagram“ (odběr i přetok v jednom CSV) nebo „Rychlá sestava“ (2 profily)
PND_SESTAVA=1/4 diagram

# Jen pro Rychlou sestavu: názvy čtvrthodinových profilů v PND „Rychlá sestava“ (prázdné = automaticky první (+A)/(-A),
# který není denní souhrn; dostupné názvy se vypíšou do logu běhu)
PND_PROFIL_ODBER=
PND_PROFIL_DODAVKA=

# 1 = ukládat screenshot každého kroku (ladění), 0 = jen při chybě
DEBUG_SNIMKY=1
